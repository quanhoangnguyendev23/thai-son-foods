# ==============================================================================
# THÁI SƠN FOODS - MẪU BIẾN MÔI TRƯỜNG CHO MÁY CHỦ PRODUCTION (.env.production.example)
# CHỈ CHỨA GIÁ TRỊ GIỮ CHỖ. KHÔNG ghi khóa / mật khẩu thật vào file này và không commit file chứa giá trị thật.
# Hướng dẫn từng bước: HUONG_DAN_TRIEN_KHAI.md
# Danh sách đầy đủ và giải thích từng biến: .env.example
# ==============================================================================

# --- 1. Chế độ chạy (DBG-01) ---
# Bắt buộc production. Chạy bằng: npm run build && npm run start:prod
NODE_ENV=production
# Đánh dấu đây là máy chủ thật: nếu lỡ chạy với NODE_ENV khác production thì app dừng ngay lúc khởi động.
APP_ENV=production

# --- 2. Database ---
# Dùng user riêng của ứng dụng (không dùng superuser postgres). Mật khẩu có ký tự đặc biệt phải mã hóa URL (@ -> %40).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
# Số kết nối tối đa của pool (tùy chọn)
DB_POOL_MAX=
# Production: lược đồ DB chỉ đổi qua migration. Để trống.
DB_SCHEMA_BOOTSTRAP=

# --- 3. Địa chỉ web, HTTPS, cookie (HTTPS-01) ---
# Tên miền thật, có https://. CHỈ đổi sang https sau khi IIS đã có HTTPS (HUONG_DAN_TRIEN_KHAI.md, Phần C).
NEXT_PUBLIC_APP_URL=https://TEN-MIEN-CUA-CONG-TY
# Origin được phép gửi POST/PUT/PATCH/DELETE, cách nhau dấu phẩy. Chỉ để tên miền https, bỏ IP/localhost.
ALLOWED_ORIGINS=https://TEN-MIEN-CUA-CONG-TY
# true khi đã chạy HTTPS. Đặt true thì đăng nhập qua http://IP:3000 sẽ KHÔNG còn được.
COOKIE_SECURE=true
# Số lớp proxy tin cậy trước app (IIS = 1).
# CHỈ đặt 1 SAU KHI cổng 3000 đã bị chặn từ bên ngoài (HUONG_DAN_TRIEN_KHAI.md, Phần B). Trước đó để 0:
# nếu cổng 3000 còn mở, kẻ xấu gửi thẳng vào cổng 3000 kèm X-Forwarded-For giả để né khóa đăng nhập / rate limit.
TRUSTED_PROXY_COUNT=1

# --- 4. Khóa bí mật (tạo mới, không dùng lại khóa cũ) ---
# Tạo: openssl rand -base64 48   (tối thiểu 32 ký tự)
JWT_SECRET=
# Tạo: openssl rand -hex 32      (tối thiểu 16 ký tự)
CRON_SECRET=
ADMIN_REGISTER_KEY=

# --- 5. Bảo mật / chức năng thử ---
# Luôn false trên production.
ENABLE_MOCK_OAUTH=false
# Mã OTP cố định CHỈ dùng cho test tự động (CI). KHÔNG BAO GIỜ đặt trên máy chủ production. Để trống.
OTP_TEST_CODE=

# --- 6. Email ---
EMAIL_PROVIDER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RESEND_API_KEY=

# --- 7. Đăng nhập Google / Facebook ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=

# --- 8. Bản đồ, gợi ý địa chỉ ---
GOOGLE_MAPS_API_KEY=
# Key hiện ra trình duyệt: phải giới hạn theo tên miền trong Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAP_SATELLITE=
GEO_PROVIDER=photon
PHOTON_BASE_URL=
DISABLE_PHOTON_GEOCODER=
GEO_APP_NAME=ThaiSonFoods
GEO_SITE_URL=https://TEN-MIEN-CUA-CONG-TY
GEO_CONTACT_EMAIL=
GEO_TIMEOUT_MS=2000

# --- 9. Lưu ảnh tải lên ---
# Máy chủ công ty: thư mục NGOÀI thư mục build, có trong lịch backup.
UPLOAD_DIR=
# Chỉ dùng khi chạy trên Vercel.
BLOB_READ_WRITE_TOKEN=

# --- 10. Công tắc chức năng ---
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false
NEXT_PUBLIC_ENABLE_PARTNER_PROGRAM=false
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=true
NEXT_PUBLIC_USE_AMAZON_HOMEPAGE=

# --- 11. Tồn kho từ Google Sheet ---
INVENTORY_SOURCE=manual
INVENTORY_SHEET_ID=
INVENTORY_SHEET_TAB=
INVENTORY_SHEET_CSV_URL=
INVENTORY_SHEET_REFRESH_MINUTES=15

# --- 12. Báo đơn (để trống = tắt) ---
ZALO_BOT_TOKEN=
ZALO_BOT_API_BASE=
ZALO_ORDER_CHAT_IDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_IDS=

# --- 13. Nhật ký ---
LOG_RETENTION_SHEET_SYNC_DAYS=90
LOG_RETENTION_INVENTORY_DAYS=730
LOG_RETENTION_AUTH_DAYS=180
LOG_RETENTION_AUDIT_DAYS=730
LOG_ARCHIVE_DIR=
