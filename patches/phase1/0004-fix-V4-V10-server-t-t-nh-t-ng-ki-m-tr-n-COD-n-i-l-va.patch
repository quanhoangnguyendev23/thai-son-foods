diff --git a/tests/phase1_order_server_total_dealer_test.mjs b/tests/phase1_order_server_total_dealer_test.mjs
new file mode 100644
index 0000000..4d3dd28
--- /dev/null
+++ b/tests/phase1_order_server_total_dealer_test.mjs
@@ -0,0 +1,122 @@
+/**
+ * PHA 1 / mục 4 — V4 (phần còn lại) + V10
+ *  V4: trần COD phải kiểm trên total do SERVER tính, không phải `total` client gửi.
+ *  V10: đơn đại lý — storeCode phải thuộc danh sách chi nhánh hợp lệ (đang hoạt động, TP.HCM);
+ *       shippingFee do server tính bằng calculateShippingFee (cùng hàm storefront), bỏ qua giá trị client.
+ * Không chạm DB: pool.query / pool.connect bị thay bằng router SQL giả.
+ * Chạy: npx tsx tests/phase1_order_server_total_dealer_test.mjs
+ */
+process.env.DATABASE_URL = 'postgresql://nobody@127.0.0.1:1/none';
+
+import assert from 'node:assert/strict';
+
+const { pool } = await import('../src/lib/db.ts');
+const { signUserToken } = await import('../src/lib/auth.ts');
+const { calculateShippingFee } = await import('../src/config/inventory.ts');
+const ordersRoute = await import('../src/app/api/orders/route.ts');
+const dealerRoute = await import('../src/app/api/dealer/orders/route.ts');
+
+// ── router SQL giả ──
+let ctx;
+function resetCtx(over = {}) {
+  ctx = { comboPrice: 11_000_000, productPrice: 4000, activeStores: ['NH', 'Q7'], inserts: [], sqls: [], ...over };
+}
+async function fakeQuery(sql, params = []) {
+  const s = String(sql).replace(/\s+/g, ' ').trim();
+  ctx.sqls.push(s);
+  if (/FROM partner_profiles/.test(s)) {
+    return { rows: [{ id: 'pp1', userId: 'u1', partnerType: 'DEALER', lifecycleStatus: 'ACTIVE', phone: '0900000001',
+      fullName: 'Dai Ly', email: 'd@x.vn', tierId: 'tier_bronze' }], rowCount: 1 };
+  }
+  if (/FROM dealer_tiers/.test(s)) return { rows: [{ id: 'tier_bronze', tier_name: 'Đồng', tier_code: 'TIER_1', discount_rate: 15 }], rowCount: 1 };
+  if (/FROM products WHERE id = \$1/.test(s)) return { rows: [{ id: params[0], name: 'Nước mắm', price: ctx.productPrice }], rowCount: 1 };
+  if (/FROM stores/.test(s) && /code = \$1/.test(s) && /is_active/.test(s)) {
+    return ctx.activeStores.includes(params[0]) ? { rows: [{ code: params[0] }], rowCount: 1 } : { rows: [], rowCount: 0 };
+  }
+  if (/FROM combos/.test(s)) return { rows: [{ name: 'Combo đắt', sale_price: ctx.comboPrice }], rowCount: 1 };
+  if (/FROM store_inventory/.test(s) && /FOR UPDATE/.test(s)) {
+    return { rows: (params[1] || []).map((id) => ({ product_id: id, stock_quantity: 1000, reserved: 0, safety_stock: 0 })), rowCount: (params[1] || []).length };
+  }
+  if (/INSERT INTO orders/.test(s)) ctx.inserts.push({ sql: s, params });
+  return { rows: [], rowCount: 0 };
+}
+pool.query = fakeQuery;
+pool.connect = async () => ({ query: fakeQuery, release() {} });
+
+const results = [];
+async function test(name, fn) {
+  try { await fn(); results.push([name, true]); console.log(`  ✓ ${name}`); }
+  catch (e) { results.push([name, false]); console.log(`  ✗ ${name}\n      ${String(e.message).split('\n')[0]}`); }
+}
+const origErr = console.error; console.error = process.env.TEST_DEBUG ? origErr : () => {};
+
+async function postOrder(over = {}) {
+  const body = {
+    fullName: 'Khach Test', phone: '0912345678', address: '123 Nguyễn Huệ, Quận 1, TP.HCM', province: 'Hồ Chí Minh',
+    paymentMethod: 'cod', items: [{ productId: 'combo-big', name: 'Combo', price: 1, quantity: 1, unit: 'Combo' }],
+    ...over,
+  };
+  const res = await ordersRoute.POST(new Request('http://t/api/orders', { method: 'POST', body: JSON.stringify(body) }));
+  return { status: res.status, body: await res.json() };
+}
+const token = await signUserToken({ id: 'u1', email: 'd@x.vn', fullName: 'Dai Ly', phone: '0900000001' });
+async function postDealer(over = {}) {
+  const body = { items: [{ productId: 'p1', quantity: 50 }], ...over };
+  const res = await dealerRoute.POST(new Request('http://t/api/dealer/orders', {
+    method: 'POST', headers: { authorization: `Bearer ${token}` }, body: JSON.stringify(body) }));
+  return { status: res.status, body: await res.json() };
+}
+
+console.log('V4 — trần COD theo total server');
+await test('client gửi total nhỏ nhưng server tính > trần COD → 400', async () => {
+  resetCtx({ comboPrice: 11_000_000 });
+  const r = await postOrder({ total: 1000, subtotal: 1000, shippingFee: 0 });
+  assert.equal(r.status, 400, JSON.stringify(r.body).slice(0, 200));
+  assert.ok(r.body.maxValue, 'phải trả maxValue của trần COD');
+  assert.equal(ctx.inserts.length, 0, 'không được tạo đơn');
+});
+await test('client gửi total khổng lồ nhưng server tính nhỏ → KHÔNG bị chặn bởi trần COD', async () => {
+  resetCtx({ comboPrice: 100_000 });
+  const r = await postOrder({ total: 999_999_999 });
+  assert.ok(!(r.status === 400 && r.body.maxValue), 'bị chặn oan do total của client');
+});
+
+console.log('V10 — đơn đại lý');
+await test('storeCode không tồn tại / không hoạt động / ngoài HCM → 400, không tạo đơn', async () => {
+  resetCtx();
+  const r = await postDealer({ storeCode: 'ZZZ' });
+  assert.equal(r.status, 400, JSON.stringify(r.body).slice(0, 200));
+  assert.equal(ctx.inserts.length, 0);
+});
+await test('storeCode hợp lệ được chấp nhận và ghi vào đơn', async () => {
+  resetCtx();
+  const r = await postDealer({ storeCode: 'Q7', shippingFee: 0 });
+  assert.equal(r.status, 200, JSON.stringify(r.body).slice(0, 200));
+  assert.equal(ctx.inserts[0].params[14], 'Q7');
+});
+await test('không gửi storeCode → mặc định NH (giữ hành vi cũ)', async () => {
+  resetCtx();
+  const r = await postDealer({});
+  assert.equal(r.status, 200, JSON.stringify(r.body).slice(0, 200));
+  assert.equal(ctx.inserts[0].params[14], 'NH');
+});
+await test('shippingFee của client bị bỏ qua: server tính bằng calculateShippingFee', async () => {
+  resetCtx({ productPrice: 4000 });                       // 50 chai × 3.400 = 170.000 < ngưỡng free
+  const expected = calculateShippingFee(170_000, null).fee;
+  assert.ok(expected > 0, 'giả định test: đơn này phải có phí ship');
+  const r = await postDealer({ shippingFee: 0 });
+  assert.equal(r.status, 200, JSON.stringify(r.body).slice(0, 200));
+  assert.equal(ctx.inserts[0].params[10], expected);
+  assert.equal(r.body.finalTotal, 170_000 + expected);
+});
+await test('shippingFee âm / quá lớn từ client không ảnh hưởng tổng', async () => {
+  resetCtx({ productPrice: 4000 });
+  const expected = calculateShippingFee(170_000, null).fee;
+  const r = await postDealer({ shippingFee: -150000 });
+  assert.equal(r.body.finalTotal, 170_000 + expected);
+});
+
+console.error = origErr;
+const failed = results.filter(([, ok]) => !ok).length;
+console.log(`\n${results.length - failed}/${results.length} pass`);
+process.exit(failed ? 1 : 0);
-- 
