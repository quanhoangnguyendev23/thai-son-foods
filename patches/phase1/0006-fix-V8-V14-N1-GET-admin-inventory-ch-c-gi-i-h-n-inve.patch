diff --git a/tests/phase1_admin_inventory_readonly_test.mjs b/tests/phase1_admin_inventory_readonly_test.mjs
new file mode 100644
index 0000000..45bbf02
--- /dev/null
+++ b/tests/phase1_admin_inventory_readonly_test.mjs
@@ -0,0 +1,117 @@
+/**
+ * PHA 1 / mục 6 — V8 + V14 + N1
+ *  V8:  GET /api/admin/inventory KHÔNG được ghi DB (trước đây INSERT ... ON CONFLICT DO NOTHING mỗi lần xem).
+ *  V14: POST /api/inventory/check giới hạn số dòng items và rate-limit theo IP.
+ *  N1:  GET /api/admin/inventory/combo-details dùng getStoreScope: STORE_STAFF chỉ xem chi nhánh của mình.
+ * Không chạm DB: pool.query / pool.connect là router SQL giả. Cần mock 'next/headers' ngoài request scope:
+ *   npx tsx --import ./tests/helpers/register_next_headers_mock.mjs tests/phase1_admin_inventory_readonly_test.mjs
+ */
+process.env.DATABASE_URL = 'postgresql://nobody@127.0.0.1:1/none';
+process.env.INVENTORY_SOURCE = 'manual';          // tránh gọi Google Sheet qua mạng
+
+import assert from 'node:assert/strict';
+
+const { pool } = await import('../src/lib/db.ts');
+const { signAdminToken, ADMIN_COOKIE_NAME } = await import('../src/lib/auth.ts');
+const invAdmin = await import('../src/app/api/admin/inventory/route.ts');
+const comboDetails = await import('../src/app/api/admin/inventory/combo-details/route.ts');
+const check = await import('../src/app/api/inventory/check/route.ts');
+
+globalThis.__TEST_COOKIES__ = {};
+let mockActive = true;
+try { const { cookies } = await import('next/headers'); await cookies(); } catch { mockActive = false; }
+if (!mockActive) {
+  console.log('SKIP: chạy với --import ./tests/helpers/register_next_headers_mock.mjs (mock next/headers).');
+  process.exit(2);
+}
+
+let sqls = [];
+const ADMINS = {
+  adm_super: { id: 'adm_super', username: 'root', email: 'r@x.vn', full_name: 'Root', role: 'SUPER_ADMIN', store_code: null, is_active: true },
+  adm_staff: { id: 'adm_staff', username: 'staff7', email: 's@x.vn', full_name: 'Staff', role: 'STORE_STAFF', store_code: 'Q7', is_active: true },
+  adm_staff0: { id: 'adm_staff0', username: 'staff0', email: 's0@x.vn', full_name: 'Staff0', role: 'STORE_STAFF', store_code: null, is_active: true },
+};
+async function fakeQuery(sql, params = []) {
+  const s = String(sql).replace(/\s+/g, ' ').trim();
+  if (!/FROM admin_users/.test(s)) sqls.push(s);
+  if (/FROM admin_users/.test(s)) return { rows: ADMINS[params[0]] ? [ADMINS[params[0]]] : [], rowCount: 1 };
+  if (/FROM products WHERE id = \$1/.test(s)) return { rows: [{ id: params[0], name: 'Nước mắm', price: 4000, unit: 'Chai' }], rowCount: 1 };
+  return { rows: [], rowCount: 0 };
+}
+pool.query = fakeQuery;
+pool.connect = async () => ({ query: fakeQuery, release() {} });
+
+async function loginAs(id) {
+  const a = ADMINS[id];
+  globalThis.__TEST_COOKIES__ = {
+    [ADMIN_COOKIE_NAME]: await signAdminToken({ id: a.id, username: a.username, email: a.email, role: a.role }),
+  };
+}
+
+const results = [];
+async function test(name, fn) {
+  try { await fn(); results.push([name, true]); console.log(`  ✓ ${name}`); }
+  catch (e) { results.push([name, false]); console.log(`  ✗ ${name}\n      ${String(e.message).split('\n')[0]}`); }
+}
+const origErr = console.error; console.error = process.env.TEST_DEBUG ? origErr : () => {};
+const writes = () => sqls.filter((s) => /^\s*(INSERT|UPDATE|DELETE|TRUNCATE|ALTER|CREATE|DROP)\b/i.test(s));
+
+console.log('V8 — GET admin/inventory không ghi');
+for (const who of ['adm_super', 'adm_staff']) {
+  await test(`GET (${who}) không phát sinh câu lệnh ghi nào`, async () => {
+    sqls = []; await loginAs(who);
+    const res = await invAdmin.GET(new Request('http://t/api/admin/inventory?storeCode=Q7'));
+    assert.equal(res.status, 200, JSON.stringify(await res.json()).slice(0, 160));
+    assert.deepEqual(writes(), [], 'GET đã ghi DB: ' + writes()[0]);
+  });
+}
+
+console.log('V14 — inventory/check');
+const post = (body, ip = '10.0.0.1') => check.POST(new Request('http://t/api/inventory/check', {
+  method: 'POST', headers: { 'x-forwarded-for': ip }, body: JSON.stringify(body) }));
+await test('items quá 30 dòng → 400 và không chạm DB', async () => {
+  sqls = [];
+  const items = Array.from({ length: 31 }, (_, i) => ({ productId: `p${i}`, quantity: 1 }));
+  const res = await post({ storeCode: 'NH', items }, '10.0.0.2');
+  assert.equal(res.status, 400);
+  assert.equal(sqls.length, 0, 'không được truy vấn DB khi đầu vào không hợp lệ');
+});
+await test('đúng 30 dòng → không bị chặn bởi giới hạn', async () => {
+  const items = Array.from({ length: 30 }, (_, i) => ({ productId: `p${i}`, quantity: 1 }));
+  const res = await post({ storeCode: 'NH', items }, '10.0.0.3');
+  assert.notEqual(res.status, 400); assert.notEqual(res.status, 429);
+});
+await test('vượt 120 request/phút từ cùng IP → 429; IP khác không bị ảnh hưởng', async () => {
+  let blockedAt = null;
+  for (let i = 1; i <= 130; i++) {
+    const res = await post({ items: [] }, '10.9.9.9');
+    if (res.status === 429) { blockedAt = i; break; }
+  }
+  assert.ok(blockedAt !== null && blockedAt <= 125, `không bị chặn (blockedAt=${blockedAt})`);
+  const other = await post({ items: [] }, '10.9.9.10');
+  assert.equal(other.status, 200);
+});
+
+console.log('N1 — combo-details theo getStoreScope');
+const getCombo = async (qs) => (await comboDetails.GET(new Request(`http://t/api/admin/inventory/combo-details?${qs}`))).json();
+await test('STORE_STAFF (Q7) xin storeCode=NH → chỉ nhận dữ liệu Q7', async () => {
+  await loginAs('adm_staff');
+  const r = await getCombo('storeCode=NH&comboId=prod-sb-01');
+  assert.equal(r.success, true, JSON.stringify(r).slice(0, 120));
+  assert.equal(r.data.storeCode, 'Q7');
+});
+await test('STORE_STAFF thiếu chi nhánh → fail-closed (không rơi về NH)', async () => {
+  await loginAs('adm_staff0');
+  const r = await getCombo('storeCode=NH&comboId=prod-sb-01');
+  assert.notEqual(r.data?.storeCode, 'NH');
+});
+await test('SUPER_ADMIN xin storeCode=NH → NH (giữ hành vi cũ)', async () => {
+  await loginAs('adm_super');
+  const r = await getCombo('storeCode=NH&comboId=prod-sb-01');
+  assert.equal(r.data.storeCode, 'NH');
+});
+
+console.error = origErr;
+const failed = results.filter(([, ok]) => !ok).length;
+console.log(`\n${results.length - failed}/${results.length} pass`);
+process.exit(failed ? 1 : 0);
-- 
