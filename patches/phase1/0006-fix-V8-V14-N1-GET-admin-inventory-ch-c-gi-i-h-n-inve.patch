+// Resolve hook: 'next/headers' -> tests/helpers/next_headers_mock.mjs
+export async function resolve(specifier, context, nextResolve) {
+  if (specifier === 'next/headers') {
+    return { url: new URL('./next_headers_mock.mjs', import.meta.url).href, shortCircuit: true };
+  }
+  return nextResolve(specifier, context);
+}
