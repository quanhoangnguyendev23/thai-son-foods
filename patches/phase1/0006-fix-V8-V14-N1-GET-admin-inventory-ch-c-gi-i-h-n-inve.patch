+// V14: endpoint công khai, mỗi dòng giỏ kéo theo nhiều truy vấn → giới hạn số dòng và tần suất theo IP
+const MAX_CHECK_ITEMS = 30;
+const CHECK_RATE_LIMIT_PER_MIN = 120;
+
 export async function POST(request: Request) {
   try {
+    const ip = request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || request.headers.get('x-real-ip') || 'unknown';
+    const rate = checkRequestRateLimit(`inv-check:ip:${ip}`, CHECK_RATE_LIMIT_PER_MIN, 60 * 1000);
+    if (rate.isBlocked) {
+      return NextResponse.json(
+        { success: false, error: 'Bạn thao tác quá nhanh. Vui lòng thử lại sau ít giây.' },
+        { status: 429, headers: { 'Retry-After': String(rate.resetInSeconds) } }
+      );
+    }
+
     const body = await request.json();
     const { storeCode, items, lat, lng, latitude, longitude, province, district, address } = body;
 
+    if (Array.isArray(items) && items.length > MAX_CHECK_ITEMS) {
+      return NextResponse.json(
+        { success: false, error: `Giỏ hàng quá lớn để kiểm tra (tối đa ${MAX_CHECK_ITEMS} dòng).` },
+        { status: 400 }
+      );
+    }
+
     // 0. Quét dọn reservation quá hạn (tự throttle 60s)
     await cleanupExpiredReservationsThrottled();
 
diff --git a/tests/helpers/next_headers_mock.mjs b/tests/helpers/next_headers_mock.mjs
new file mode 100644
index 0000000..a0bd773
--- /dev/null
+++ b/tests/helpers/next_headers_mock.mjs
@@ -0,0 +1,9 @@
+// Thay thế 'next/headers' trong test: cookie lấy từ globalThis.__TEST_COOKIES__ (không có => giống ngoài request scope).
+export async function cookies() {
+  const jar = globalThis.__TEST_COOKIES__;
+  if (!jar) throw new Error('cookies() ngoài request scope');
+  return { get: (name) => (jar[name] === undefined ? undefined : { name, value: jar[name] }) };
+}
+export async function headers() {
+  throw new Error('headers() ngoài request scope');
+}
