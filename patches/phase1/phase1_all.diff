+  }
+  if (/FROM dealer_tiers/.test(s)) return { rows: [{ id: 'tier_bronze', tier_name: 'Đồng', tier_code: 'TIER_1', discount_rate: 15 }], rowCount: 1 };
+  if (/FROM products WHERE id = \$1/.test(s)) return { rows: [{ id: params[0], name: 'Nước mắm', price: 4000, unit: 'Chai' }], rowCount: 1 };
+  if (/FROM stores/.test(s) && /is_active/.test(s)) return { rows: [{ code: params[0] }], rowCount: 1 };
+  if (/FROM store_inventory/.test(s) && /FOR UPDATE/.test(s)) {
+    return { rows: (params[1] || []).map((id) => ({ product_id: id, stock_quantity: 1e9, reserved: 0, safety_stock: 0 })), rowCount: (params[1] || []).length };
+  }
+  if (/INSERT INTO orders/.test(s)) ctx.inserts.push(params);
+  return { rows: [], rowCount: 0 };
+}
+pool.query = fakeQuery;
+pool.connect = async () => ({ query: fakeQuery, release() {} });
+
+const results = [];
+async function test(name, fn) {
+  try { await fn(); results.push([name, true]); console.log(`  ✓ ${name}`); }
+  catch (e) { results.push([name, false]); console.log(`  ✗ ${name}\n      ${String(e.message).split('\n')[0]}`); }
+}
+const origErr = console.error; console.error = process.env.TEST_DEBUG ? origErr : () => {};
+
+const line = (over = {}) => ({ productId: 'prod-sb-01', name: 'Nước mắm', price: 4000, quantity: 1, unit: 'Chai', ...over });
+async function postOrder(items) {
+  const body = { fullName: 'Khach Test', phone: '0912345678', address: '123 Nguyễn Huệ, Quận 1, TP.HCM',
+    province: 'Hồ Chí Minh', paymentMethod: 'bank_transfer', items };
+  const res = await ordersRoute.POST(new Request('http://t/api/orders', { method: 'POST', body: JSON.stringify(body) }));
+  return { status: res.status, body: await res.json() };
+}
+const token = await signUserToken({ id: 'u1', email: 'd@x.vn', fullName: 'Dai Ly', phone: '0900000001' });
+async function postDealer(items) {
+  const res = await dealerRoute.POST(new Request('http://t/api/dealer/orders', {
+    method: 'POST', headers: { authorization: `Bearer ${token}` }, body: JSON.stringify({ items }) }));
+  return { status: res.status, body: await res.json() };
+}
+const rejected = (r) => { assert.equal(r.status, 400, JSON.stringify(r.body).slice(0, 160)); assert.equal(ctx.inserts.length, 0, 'không được tạo đơn'); };
+
+console.log('V3 — trần 1.000 chai (storefront)');
+await test('2 dòng × 600 chai (tổng 1.200) → 400, không tạo đơn', async () => {
+  resetCtx();
+  rejected(await postOrder([line({ productId: 'prod-sb-01', quantity: 600 }), line({ productId: 'prod-sb-02', quantity: 600 })]));
+});
+await test('đúng 1.000 chai → không bị chặn bởi trần', async () => {
+  resetCtx();
+  const r = await postOrder([line({ quantity: 1000 })]);
+  assert.notEqual(r.body.code, 'INVALID_ORDER_ITEMS');
+  assert.ok(!/1\.000 chai/.test(String(r.body.error || '')), 'bị chặn oan ở đúng 1.000 chai');
+});
+
+console.log('Validate số lượng — storefront');
+for (const [label, q] of [['âm', -5], ['0', 0], ['thập phân 1.5', 1.5], ['chuỗi "abc"', 'abc'], ['chuỗi "Infinity"', 'Infinity'],
+  ['rất lớn 1e30', 1e30], ['mảng', [1]], ['object', {}], ['boolean', true], ['vượt trần dòng 1001', 1001]]) {
+  await test(`quantity ${label} → 400`, async () => { resetCtx(); rejected(await postOrder([line({ quantity: q })])); });
+}
+await test('quantity thiếu → vẫn mặc định 1 (giữ hành vi cũ)', async () => {
+  resetCtx();
+  const it = line(); delete it.quantity;
+  const r = await postOrder([it]);
+  assert.notEqual(r.body.code, 'INVALID_ORDER_ITEMS');
+});
+await test('quantity chuỗi số nguyên "3" → chấp nhận', async () => {
+  resetCtx();
+  const r = await postOrder([line({ quantity: '3' })]);
+  assert.notEqual(r.body.code, 'INVALID_ORDER_ITEMS');
+});
+
+console.log('Validate kiểu / giá / số dòng — storefront');
+await test('productId là số (không phải chuỗi) → 400 (không phải 500)', async () => { resetCtx(); rejected(await postOrder([line({ productId: 12345 })])); });
+await test('phần tử items là null → 400', async () => { resetCtx(); rejected(await postOrder([null])); });
+await test('price âm → 400', async () => { resetCtx(); rejected(await postOrder([line({ price: -1000 })])); });
+await test('price "Infinity" → 400', async () => { resetCtx(); rejected(await postOrder([line({ price: 'Infinity' })])); });
+await test(`quá ${cfg.INVENTORY_CONFIG.ORDER_LIMITS?.MAX_LINES} dòng → 400`, async () => {
+  resetCtx();
+  const many = Array.from({ length: (cfg.INVENTORY_CONFIG.ORDER_LIMITS?.MAX_LINES ?? 100) + 1 }, (_, i) => line({ productId: `prod-${i}` }));
+  rejected(await postOrder(many));
+});
+
+console.log('Validate số lượng — đại lý');
+await test('50 chai + dòng quantity âm → 400 (trước đây bị ép thành 1 và nhận đơn)', async () => {
+  resetCtx(); rejected(await postDealer([line({ productId: 'p1', quantity: 50 }), line({ productId: 'p2', quantity: -5 })]));
+});
+await test('50 chai + dòng quantity "abc" → 400', async () => {
+  resetCtx(); rejected(await postDealer([line({ productId: 'p1', quantity: 50 }), line({ productId: 'p2', quantity: 'abc' })]));
+});
+await test('50 chai + dòng quantity 1.5 → 400', async () => {
+  resetCtx(); rejected(await postDealer([line({ productId: 'p1', quantity: 50 }), line({ productId: 'p2', quantity: 1.5 })]));
+});
+await test('quantity 1e30 → 400 (không còn rơi xuống 409 tồn kho)', async () => {
+  resetCtx(); rejected(await postDealer([line({ productId: 'p1', quantity: 1e30 })]));
+});
+await test('đơn sỉ hợp lệ 50 chai vẫn tạo được', async () => {
+  resetCtx();
+  const r = await postDealer([line({ productId: 'p1', quantity: 50 })]);
+  assert.equal(r.status, 200, JSON.stringify(r.body).slice(0, 160));
+});
+
+console.error = origErr;
+const failed = results.filter(([, ok]) => !ok).length;
+console.log(`\n${results.length - failed}/${results.length} pass`);
+process.exit(failed ? 1 : 0);
diff --git a/tests/phase1_order_server_total_dealer_test.mjs b/tests/phase1_order_server_total_dealer_test.mjs
new file mode 100644
index 0000000..4d3dd28
--- /dev/null
+++ b/tests/phase1_order_server_total_dealer_test.mjs
@@ -0,0 +1,122 @@
+/**
+ * PHA 1 / mục 4 — V4 (phần còn lại) + V10
+ *  V4: trần COD phải kiểm trên total do SERVER tính, không phải `total` client gửi.
+ *  V10: đơn đại lý — storeCode phải thuộc danh sách chi nhánh hợp lệ (đang hoạt động, TP.HCM);
+ *       shippingFee do server tính bằng calculateShippingFee (cùng hàm storefront), bỏ qua giá trị client.
+ * Không chạm DB: pool.query / pool.connect bị thay bằng router SQL giả.
+ * Chạy: npx tsx tests/phase1_order_server_total_dealer_test.mjs
+ */
+process.env.DATABASE_URL = 'postgresql://nobody@127.0.0.1:1/none';
+
+import assert from 'node:assert/strict';
+
+const { pool } = await import('../src/lib/db.ts');
+const { signUserToken } = await import('../src/lib/auth.ts');
+const { calculateShippingFee } = await import('../src/config/inventory.ts');
+const ordersRoute = await import('../src/app/api/orders/route.ts');
+const dealerRoute = await import('../src/app/api/dealer/orders/route.ts');
+
+// ── router SQL giả ──
+let ctx;
+function resetCtx(over = {}) {
+  ctx = { comboPrice: 11_000_000, productPrice: 4000, activeStores: ['NH', 'Q7'], inserts: [], sqls: [], ...over };
+}
+async function fakeQuery(sql, params = []) {
+  const s = String(sql).replace(/\s+/g, ' ').trim();
+  ctx.sqls.push(s);
+  if (/FROM partner_profiles/.test(s)) {
+    return { rows: [{ id: 'pp1', userId: 'u1', partnerType: 'DEALER', lifecycleStatus: 'ACTIVE', phone: '0900000001',
+      fullName: 'Dai Ly', email: 'd@x.vn', tierId: 'tier_bronze' }], rowCount: 1 };
+  }
+  if (/FROM dealer_tiers/.test(s)) return { rows: [{ id: 'tier_bronze', tier_name: 'Đồng', tier_code: 'TIER_1', discount_rate: 15 }], rowCount: 1 };
+  if (/FROM products WHERE id = \$1/.test(s)) return { rows: [{ id: params[0], name: 'Nước mắm', price: ctx.productPrice }], rowCount: 1 };
+  if (/FROM stores/.test(s) && /code = \$1/.test(s) && /is_active/.test(s)) {
+    return ctx.activeStores.includes(params[0]) ? { rows: [{ code: params[0] }], rowCount: 1 } : { rows: [], rowCount: 0 };
+  }
+  if (/FROM combos/.test(s)) return { rows: [{ name: 'Combo đắt', sale_price: ctx.comboPrice }], rowCount: 1 };
+  if (/FROM store_inventory/.test(s) && /FOR UPDATE/.test(s)) {
+    return { rows: (params[1] || []).map((id) => ({ product_id: id, stock_quantity: 1000, reserved: 0, safety_stock: 0 })), rowCount: (params[1] || []).length };
+  }
+  if (/INSERT INTO orders/.test(s)) ctx.inserts.push({ sql: s, params });
+  return { rows: [], rowCount: 0 };
+}
+pool.query = fakeQuery;
+pool.connect = async () => ({ query: fakeQuery, release() {} });
+
+const results = [];
+async function test(name, fn) {
+  try { await fn(); results.push([name, true]); console.log(`  ✓ ${name}`); }
+  catch (e) { results.push([name, false]); console.log(`  ✗ ${name}\n      ${String(e.message).split('\n')[0]}`); }
+}
+const origErr = console.error; console.error = process.env.TEST_DEBUG ? origErr : () => {};
+
+async function postOrder(over = {}) {
+  const body = {
+    fullName: 'Khach Test', phone: '0912345678', address: '123 Nguyễn Huệ, Quận 1, TP.HCM', province: 'Hồ Chí Minh',
+    paymentMethod: 'cod', items: [{ productId: 'combo-big', name: 'Combo', price: 1, quantity: 1, unit: 'Combo' }],
+    ...over,
+  };
+  const res = await ordersRoute.POST(new Request('http://t/api/orders', { method: 'POST', body: JSON.stringify(body) }));
+  return { status: res.status, body: await res.json() };
+}
+const token = await signUserToken({ id: 'u1', email: 'd@x.vn', fullName: 'Dai Ly', phone: '0900000001' });
+async function postDealer(over = {}) {
+  const body = { items: [{ productId: 'p1', quantity: 50 }], ...over };
+  const res = await dealerRoute.POST(new Request('http://t/api/dealer/orders', {
+    method: 'POST', headers: { authorization: `Bearer ${token}` }, body: JSON.stringify(body) }));
+  return { status: res.status, body: await res.json() };
+}
+
+console.log('V4 — trần COD theo total server');
+await test('client gửi total nhỏ nhưng server tính > trần COD → 400', async () => {
+  resetCtx({ comboPrice: 11_000_000 });
+  const r = await postOrder({ total: 1000, subtotal: 1000, shippingFee: 0 });
+  assert.equal(r.status, 400, JSON.stringify(r.body).slice(0, 200));
+  assert.ok(r.body.maxValue, 'phải trả maxValue của trần COD');
+  assert.equal(ctx.inserts.length, 0, 'không được tạo đơn');
+});
+await test('client gửi total khổng lồ nhưng server tính nhỏ → KHÔNG bị chặn bởi trần COD', async () => {
+  resetCtx({ comboPrice: 100_000 });
+  const r = await postOrder({ total: 999_999_999 });
+  assert.ok(!(r.status === 400 && r.body.maxValue), 'bị chặn oan do total của client');
+});
+
+console.log('V10 — đơn đại lý');
+await test('storeCode không tồn tại / không hoạt động / ngoài HCM → 400, không tạo đơn', async () => {
+  resetCtx();
+  const r = await postDealer({ storeCode: 'ZZZ' });
+  assert.equal(r.status, 400, JSON.stringify(r.body).slice(0, 200));
+  assert.equal(ctx.inserts.length, 0);
+});
+await test('storeCode hợp lệ được chấp nhận và ghi vào đơn', async () => {
+  resetCtx();
+  const r = await postDealer({ storeCode: 'Q7', shippingFee: 0 });
+  assert.equal(r.status, 200, JSON.stringify(r.body).slice(0, 200));
+  assert.equal(ctx.inserts[0].params[14], 'Q7');
+});
+await test('không gửi storeCode → mặc định NH (giữ hành vi cũ)', async () => {
+  resetCtx();
+  const r = await postDealer({});
+  assert.equal(r.status, 200, JSON.stringify(r.body).slice(0, 200));
+  assert.equal(ctx.inserts[0].params[14], 'NH');
+});
+await test('shippingFee của client bị bỏ qua: server tính bằng calculateShippingFee', async () => {
+  resetCtx({ productPrice: 4000 });                       // 50 chai × 3.400 = 170.000 < ngưỡng free
+  const expected = calculateShippingFee(170_000, null).fee;
+  assert.ok(expected > 0, 'giả định test: đơn này phải có phí ship');
+  const r = await postDealer({ shippingFee: 0 });
+  assert.equal(r.status, 200, JSON.stringify(r.body).slice(0, 200));
+  assert.equal(ctx.inserts[0].params[10], expected);
+  assert.equal(r.body.finalTotal, 170_000 + expected);
+});
+await test('shippingFee âm / quá lớn từ client không ảnh hưởng tổng', async () => {
+  resetCtx({ productPrice: 4000 });
+  const expected = calculateShippingFee(170_000, null).fee;
+  const r = await postDealer({ shippingFee: -150000 });
+  assert.equal(r.body.finalTotal, 170_000 + expected);
+});
+
+console.error = origErr;
+const failed = results.filter(([, ok]) => !ok).length;
+console.log(`\n${results.length - failed}/${results.length} pass`);
+process.exit(failed ? 1 : 0);
diff --git a/tests/phase1_release_stock_log_test.mjs b/tests/phase1_release_stock_log_test.mjs
new file mode 100644
index 0000000..196992d
--- /dev/null
+++ b/tests/phase1_release_stock_log_test.mjs
@@ -0,0 +1,93 @@
+/**
+ * PHA 1 / mục 3 — V13: releaseStock phải ghi log khi hoàn tồn của đơn ĐÃ trừ kho (nhánh inventory_deducted = true).
+ * Không dùng DB: FakePgClient. Chạy: npx tsx tests/phase1_release_stock_log_test.mjs
+ */
+process.env.DATABASE_URL = 'postgresql://nobody@127.0.0.1:1/none';
+
+import assert from 'node:assert/strict';
+import { FakePgClient } from './helpers/fake_pg_client.mjs';
+
+const inv = await import('../src/lib/inventory.ts');
+const { pool } = await import('../src/lib/db.ts');
+pool.query = async () => ({ rows: [], rowCount: 0 });
+pool.connect = async () => { throw new Error('pool.connect bị chặn trong test'); };
+
+const results = [];
+async function test(name, fn) {
+  const prevSource = process.env.INVENTORY_SOURCE;
+  try { await fn(); results.push(true); console.log(`  ✓ ${name}`); }
+  catch (e) { results.push(false); console.log(`  ✗ ${name}\n      ${String(e.message).split('\n')[0]}`); }
+  finally { if (prevSource === undefined) delete process.env.INVENTORY_SOURCE; else process.env.INVENTORY_SOURCE = prevSource; }
+}
+
+// params của INSERT inventory_logs: [id, store, product, old_stock, new_stock, old_reserved, new_reserved, change_type, order_id, actor, note]
+function buildClient({ withConfirmedReservations = true, ...opts } = {}) {
+  const st = { stock: 100, reserved: 0 };
+  const c = new FakePgClient(opts);
+  c.st = st;
+  c.when(/FROM orders WHERE id = \$1 FOR UPDATE/, () => [{ id: 'ord1', status: 'CONFIRMED', store_code: 'NH', inventory_deducted: true }]);
+  c.when(/FROM stock_reservations WHERE order_id = \$1 AND status = 'confirmed'/, () =>
+    withConfirmedReservations ? [{ id: 'r1', store_code: 'NH', product_id: 'prod-sb-01', quantity: 14 }] : []);
+  c.when(/SELECT stock_quantity, reserved FROM store_inventory WHERE store_code = \$1 AND product_id = \$2/, () => [{ stock_quantity: st.stock, reserved: st.reserved }]);
+  c.when(/UPDATE store_inventory SET stock_quantity = CASE WHEN \$5::boolean/, (p) => { if (!p[4]) st.stock += p[0]; });
+  c.when(/UPDATE store_inventory SET stock_quantity = stock_quantity \+ \$1/, (p) => { st.stock += p[0]; });
+  // fallback đơn cũ (không có reservation)
+  c.when(/FROM order_items WHERE order_id/, () => [{ productId: 'prod-sb-01', name: 'Sữa bắp nếp', quantity: 2, unit: 'Lốc 7 chai' }]);
+  c.when(/FROM combos WHERE id/, () => []);
+  c.when(/FROM products WHERE id = \$1/, () => [{ id: 'prod-sb-01', name: 'Sữa bắp nếp', price: 18000, unit: 'chai' }]);
+  c.when(/FROM product_variants WHERE id = \$1 OR id = \$2/, () => [{ bottle_multiplier: 7, quantity: 7 }]);
+  return c;
+}
+const restoreLogs = (c) => c.logRows.filter((p) => p[7] === 'order_cancelled');
+
+console.log('V13 — releaseStock ghi log khi hoàn tồn đơn đã trừ kho');
+
+await test('manual mode, có reservation confirmed: ghi log hoàn tồn với tồn trước/sau thật', async () => {
+  process.env.INVENTORY_SOURCE = 'manual';
+  const c = buildClient();
+  await c.query('BEGIN;');
+  const res = await inv.releaseStock('ord1', c, 'Khách hủy', 'qa_admin', true);
+  assert.equal(res.action, 'restored_stock');
+  const logs = restoreLogs(c);
+  assert.equal(logs.length, 1, 'phải có đúng 1 log hoàn tồn');
+  assert.deepEqual([logs[0][1], logs[0][2], logs[0][3], logs[0][4]], ['NH', 'prod-sb-01', 100, 114]);
+  assert.equal(logs[0][9], 'qa_admin');
+  assert.match(logs[0][10], /Hoàn tồn 14 chai/);
+});
+
+await test('sheet mode: vẫn ghi log nhưng tồn vật lý không đổi (kế toán chỉnh trong sheet)', async () => {
+  delete process.env.INVENTORY_SOURCE;                   // mặc định = sheet
+  const c = buildClient();
+  await c.query('BEGIN;');
+  await inv.releaseStock('ord1', c, 'Khách hủy', 'qa_admin', true);
+  const logs = restoreLogs(c);
+  assert.equal(logs.length, 1);
+  assert.deepEqual([logs[0][3], logs[0][4]], [100, 100]);
+  assert.equal(c.st.stock, 100);
+});
+
+await test('đơn cũ không có reservation (fallback), manual mode: cũng ghi log hoàn tồn', async () => {
+  process.env.INVENTORY_SOURCE = 'manual';
+  const c = buildClient({ withConfirmedReservations: false });
+  await c.query('BEGIN;');
+  await inv.releaseStock('ord1', c, 'Khách hủy', 'qa_admin', true);
+  const logs = restoreLogs(c);
+  assert.equal(logs.length, 1);
+  assert.deepEqual([logs[0][2], logs[0][3], logs[0][4]], ['prod-sb-01', 100, 114]);
+});
+
+await test('lỗi ghi log hoàn tồn KHÔNG làm hỏng việc hủy đơn (dùng cách ghi log an toàn của V12)', async () => {
+  process.env.INVENTORY_SOURCE = 'manual';
+  const c = buildClient({ failInsertLog: () => true });
+  await c.query('BEGIN;');
+  const res = await inv.releaseStock('ord1', c, 'Khách hủy', 'qa_admin', true);
+  assert.equal(res.success, true);
+  assert.equal(c.st.stock, 114, 'tồn vẫn được hoàn');
+  assert.ok(c.queries.some((q) => /INSERT INTO inventory_logs/i.test(q.sql)), 'phải có thử ghi log hoàn tồn');
+  const commit = await c.query('COMMIT;');
+  assert.equal(commit.command, 'COMMIT');
+});
+
+const failed = results.filter((x) => !x).length;
+console.log(`\nKẾT QUẢ: ${results.length - failed}/${results.length} đạt${failed ? `, ${failed} LỖI` : ''}`);
+process.exit(failed ? 1 : 0);
