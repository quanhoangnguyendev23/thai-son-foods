+/**
+ * Chuẩn hóa số lượng từ client: thiếu (undefined/null) => 1 (giữ hành vi cũ);
+ * còn lại phải là số nguyên dương hữu hạn (number hoặc chuỗi số nguyên) và <= max. Sai => null.
+ */
+export function parseOrderQuantity(raw: unknown, max: number): number | null {
+  if (raw === undefined || raw === null) return 1;
+  let n: number;
+  if (typeof raw === 'number') {
+    n = raw;
+  } else if (typeof raw === 'string' && /^\s*\d{1,9}\s*$/.test(raw)) {
+    n = Number(raw.trim());
+  } else {
+    return null;
+  }
+  if (!Number.isSafeInteger(n) || n < 1 || n > max) return null;
+  return n;
+}
