+
+/**
+ * Lỗi khi COMMIT không thực sự lưu dữ liệu (Postgres trả về command = 'ROLLBACK' thay vì 'COMMIT',
+ * xảy ra khi transaction đã ở trạng thái aborted nhưng nơi gọi nuốt lỗi).
+ */
+export class TransactionNotCommittedError extends Error {
+  constructor(label: string, command?: string) {
+    super(`${label}: giao dịch không được lưu (COMMIT trả về "${command ?? 'không rõ'}"). Dữ liệu không thay đổi.`);
+    this.name = 'TransactionNotCommittedError';
+  }
+}
+
+/** Gọi ngay sau `await client.query('COMMIT;')` để không báo "thành công" khi COMMIT thực chất là ROLLBACK. */
+export function assertTransactionCommitted(
+  result: { command?: string } | null | undefined,
+  label: string = 'Giao dịch'
+): void {
+  if (!result || result.command !== 'COMMIT') {
+    throw new TransactionNotCommittedError(label, result?.command);
+  }
+}
+
+/** Đọc nhanh tồn vật lý và đang giữ chỗ của một nhóm sản phẩm tại một kho (dùng để ghi log trước/sau). */
+export async function getInventorySnapshot(
+  client: PoolClient,
+  storeCode: string,
+  productIds: string[]
+): Promise<Map<string, { stock: number; reserved: number }>> {
+  const snap = new Map<string, { stock: number; reserved: number }>();
+  if (productIds.length === 0) return snap;
+  const res = await client.query(
+    `SELECT product_id, stock_quantity, reserved FROM store_inventory WHERE store_code = $1 AND product_id = ANY($2);`,
+    [storeCode, productIds]
+  );
+  for (const row of res.rows) {
+    snap.set(row.product_id, { stock: Number(row.stock_quantity) || 0, reserved: Number(row.reserved) || 0 });
   }
+  return snap;
 }
 
