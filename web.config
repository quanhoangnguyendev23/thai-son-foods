<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- HTTPS-01: chuyển hướng HTTP -> HTTPS. ĐANG TẮT (enabled="false").
                     CHỈ bật khi IIS đã có binding HTTPS với chứng chỉ hợp lệ (xem HUONG_DAN_TRIEN_KHAI.md, Phần C).
                     Bật xong thì truy cập bằng http://... sẽ bị chuyển sang https://... -->
                <rule name="RedirectHttpToHttps" enabled="false" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
                </rule>
                <rule name="ReverseProxyToNextJs" stopProcessing="true">
                    <match url="(.*)" />
                    <!-- HTTPS-01: lấy scheme thật của request (http hoặc https) thay vì ép cứng "http".
                         Đang chạy HTTP thì giá trị vẫn là "http" như trước. -->
                    <conditions>
                        <add input="{CACHE_URL}" pattern="^(https?)://" />
                    </conditions>
                    <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
                    <serverVariables>
                        <set name="HTTP_X_FORWARDED_PROTO" value="{C:1}" />
                    </serverVariables>
                </rule>
            </rules>
            <outboundRules>
                <!-- HTTPS-01: header HSTS do IIS gắn, chỉ trên response HTTPS. ĐANG TẮT (enabled="false").
                     Ứng dụng (next.config.ts) đã tự gửi "max-age=63072000; includeSubDomains" khi NODE_ENV=production.
                     Chỉ bật rule này nếu IT KHÔNG đồng ý includeSubDomains: nó ghi đè header của ứng dụng bằng giá trị
                     không có includeSubDomains. Chỉ bật khi HTTPS đã chạy ổn định (xem HUONG_DAN_TRIEN_KHAI.md, Phần C). -->
                <rule name="HstsOnlyOnHttps" enabled="false">
                    <match serverVariable="RESPONSE_Strict_Transport_Security" pattern=".*" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^ON$" />
                    </conditions>
                    <action type="Rewrite" value="max-age=31536000" />
                </rule>
            </outboundRules>
        </rewrite>
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
            </customHeaders>
        </httpProtocol>
        <security>
            <requestFiltering>
                <!-- Cho phép upload ảnh lên đến 50MB cho trang quản trị -->
                <requestLimits maxAllowedContentLength="52428800" />
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
 













