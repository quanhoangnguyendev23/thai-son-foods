generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  nameEn    String?   @map("name_en")
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  nameEn           String?          @map("name_en")
  sku              String?
  volume           String?
  shortDescription String?          @map("short_description")
  description      String?
  price            Int
  costPrice        Int?             @default(0) @map("cost_price")
  unit             String           @default("1 chai")
  thumbnail        String
  isFeatured       Boolean          @default(false) @map("is_featured")
  isNew            Boolean          @default(false) @map("is_new")
  isBestSeller     Boolean          @default(false) @map("is_best_seller")
  isActive         Boolean          @default(true) @map("is_active")
  isVegan          Boolean          @default(true) @map("is_vegan")
  categoryId       String?          @map("category_id")
  category         Category?        @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  imageType String   @default("gallery") @map("image_type")
  isActive  Boolean  @default(true) @map("is_active")
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_images")
}

model ProductVariant {
  id               String  @id @default(cuid())
  name             String
  quantity         Int     @default(1)
  price            Int
  unit             String  @default("chai")
  volume           String?
  bottleMultiplier Int     @default(1) @map("bottle_multiplier")
  productId        String  @map("product_id")
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model Combo {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  nameEn        String?      @map("name_en")
  description   String?
  descriptionEn String?      @map("description_en")
  originalPrice Int          @map("original_price")
  salePrice     Int          @map("sale_price")
  costPrice     Int?         @default(0) @map("cost_price")
  totalItems    Int          @default(10) @map("total_items")
  discount      Int          @default(0)
  image         String?
  isFeatured    Boolean      @default(true) @map("is_featured")
  isBestSeller  Boolean      @default(false) @map("is_best_seller")
  isActive      Boolean      @default(true) @map("is_active")
  items         ComboItem[]
  images        ComboImage[]
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("combos")
}

model ComboImage {
  id        String   @id @default(cuid())
  comboId   String   @map("combo_id")
  combo     Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  imageType String   @default("gallery") @map("image_type")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("combo_images")
}

model Banner {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String?
  subtitle    String?
  tag         String?
  image       String
  mobileImage String?  @map("mobile_image")
  alt         String?
  link        String?
  placement   String   @default("hero")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

model BrandSlide {
  id          String   @id @default(cuid())
  tag         String
  title       String
  description String
  image       String
  ctaText     String   @default("Khám phá Thái Sơn") @map("cta_text")
  ctaLink     String   @default("/#san-pham") @map("cta_link")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("brand_slides")
}

model ComboItem {
  id        String  @id @default(cuid())
  comboId   String  @map("combo_id")
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  quantity  Int     @default(1)
  unit      String  @default("chai")

  @@map("combo_items")
}

model Order {
  id                String      @id @default(cuid())
  orderCode         String      @unique @map("order_code")
  fullName          String      @map("full_name")
  phone             String
  email             String?
  province          String
  district          String
  ward              String
  address           String
  note              String?
  paymentMethod     String      @default("cod") @map("payment_method")
  shippingFee       Int         @default(0) @map("shipping_fee")
  subtotal          Int
  total             Int
  status            String      @default("PENDING")
  userId            String?     @map("user_id")
  storeCode         String?     @map("store_code")
  storeAddress      String?     @map("store_address")
  inventoryDeducted Boolean     @default(false) @map("inventory_deducted")
  itemsResolvedCount Int        @default(0) @map("items_resolved_count")
  itemsTotalCount   Int         @default(0) @map("items_total_count")
  items             OrderItem[]
  createdAt         DateTime    @default(now()) @map("created_at")

  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String   @map("order_id")
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String?  @map("product_id")
  product             Product? @relation(fields: [productId], references: [id])
  canonicalProductId  String?  @map("canonical_product_id")
  name                String
  price               Int
  costPrice           Int?     @map("cost_price")
  quantity            Int
  unit                String   @default("1 chai")
  thumbnail           String?
  comboSnapshot       Json?    @map("combo_snapshot")
  bottleMultiplier    Int      @default(1) @map("bottle_multiplier")
  totalBottles        Int      @default(0) @map("total_bottles")

  @@map("order_items")
}

model Store {
  code      String   @id
  name      String
  address   String
  district  String?
  province  String?  @default("Hồ Chí Minh")
  ward      String?
  phone     String?
  latitude  Float?
  longitude Float?
  mapUrl    String?  @map("map_url")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("stores")
}

model StoreInventory {
  id            String    @id
  storeCode     String    @map("store_code")
  productId     String    @map("product_id")
  stockQuantity Int       @default(100) @map("stock_quantity")
  reserved      Int       @default(0)
  safetyStock   Int       @default(0) @map("safety_stock")
  updatedAt     DateTime? @updatedAt @map("updated_at")
  updatedBy     String?   @map("updated_by")

  @@unique([storeCode, productId])
  @@map("store_inventory")
}

model StockReservation {
  id         String    @id
  orderId    String    @map("order_id")
  storeCode  String    @map("store_code")
  productId  String    @map("product_id")
  quantity   Int
  status     String    @default("active") // active | confirmed | released | expired
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  releasedAt DateTime? @map("released_at")

  @@index([orderId])
  @@index([storeCode, productId])
  @@index([status, expiresAt])
  @@map("stock_reservations")
}

model InventoryLog {
  id          String   @id
  storeCode   String   @map("store_code")
  productId   String   @map("product_id")
  oldStock    Int      @map("old_stock")
  newStock    Int      @map("new_stock")
  oldReserved Int      @default(0) @map("old_reserved")
  newReserved Int      @default(0) @map("new_reserved")
  changeType  String   @map("change_type")
  orderId     String?  @map("order_id")
  actor       String
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([storeCode])
  @@index([productId])
  @@index([createdAt])
  @@index([orderId])
  @@map("inventory_logs")
}

model AdminUser {
  id                 String    @id @default(cuid())
  username           String    @unique
  email              String    @unique
  passwordHash       String    @map("password_hash")
  fullName           String?   @map("full_name")
  role               String    @default("STORE_STAFF") // SUPER_ADMIN, MARKETING, STORE_STAFF
  storeCode          String?   @map("store_code")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  lastLoginAt        DateTime? @map("last_login_at")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("admin_users")
}

model AuditLog {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now()) @map("created_at")
  adminId       String?  @map("admin_id")
  adminUsername String?  @map("admin_username")
  role          String?
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  storeCode     String?  @map("store_code")
  beforeJson    Json?    @map("before_json")
  afterJson     Json?    @map("after_json")
  ip            String?
  userAgent     String?  @map("user_agent")

  @@index([createdAt])
  @@index([adminUsername])
  @@index([action])
  @@index([storeCode])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Cài đặt chung của website (khoá → giá trị), vd daily_deals_enabled. Xem src/lib/site-settings.ts
model SiteSetting {
  key       String    @id @db.VarChar(100)
  value     Json
  updatedBy String?   @map("updated_by") @db.VarChar(100)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

