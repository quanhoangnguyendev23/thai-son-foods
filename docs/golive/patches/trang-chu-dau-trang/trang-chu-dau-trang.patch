+  if (s === 'PROCESSING' || s === 'SHIPPING') return { label: isEn ? 'Shipping' : 'Đang giao hàng', className: 'bg-blue-100 text-blue-800' };
+  if (s === 'CANCELLED') return { label: isEn ? 'Cancelled' : 'Đã hủy', className: 'bg-rose-100 text-rose-800' };
