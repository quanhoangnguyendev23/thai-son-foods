# ==============================================================================
# THÁI SƠN FOODS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO THIS FILE.
# ==============================================================================

# 1. PostgreSQL Database Configuration
DATABASE_URL="postgresql://username:password@127.0.0.1:5432/WebTSF_production?sslmode=disable"
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="your_database_password_here"
DB_NAME="WebTSF_production"
NEXT_PUBLIC_APP_URL="https://thaisonfoods.vn"

# 2. Authentication & JWT Security
# Generate high-entropy secret: openssl rand -base64 48
JWT_SECRET="replace_with_a_secure_random_jwt_secret_min_32_characters"
ADMIN_REGISTER_KEY="replace_with_secure_initial_admin_register_key"

# 3. Security & Feature Toggles
# MUST be false on production to prevent unauthorized account takeover bypass
ENABLE_MOCK_OAUTH=false

# 3b. Reverse proxy, CSRF và IP khách (đọc lúc chạy — đổi chỉ cần khởi động lại, không cần build lại)
# Số lớp reverse proxy tin cậy đứng trước app. 0 = khách kết nối thẳng vào Next (localhost / LAN):
# khi đó app KHÔNG tin header IP nào, mọi request dùng chung một nhóm rate limit "unknown".
# Production sau 1 reverse proxy (nginx/IIS) = 1. Proxy phải NỐI IP khách vào cuối X-Forwarded-For.
TRUSTED_PROXY_COUNT=0
# Origin được phép gửi POST/PUT/PATCH/DELETE ngoài Host của request, cách nhau dấu phẩy.
# Dùng khi proxy đổi Host. Ví dụ production: https://thaisonfood.tsf.com.vn ; LAN: http://<IP LAN>:3000
ALLOWED_ORIGINS=
# Cờ Secure cho cookie đăng nhập. Bỏ trống = Secure khi NODE_ENV=production.
# LAN Testing chạy bản build production qua http://<IP LAN> phải đặt false. Production (HTTPS) để trống hoặc true.
COOKIE_SECURE=

# 4. Automated Cronjob Authentication Key
# Generate high-entropy secret: openssl rand -hex 32
CRON_SECRET="replace_with_strong_random_cron_secret_min_32_characters"

# 5. Social OAuth 2.0 (Google & Facebook)
# Google Cloud Console (APIs & Services > Credentials):
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta for Developers (developers.facebook.com > App Dashboard):
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# 6. Email Service Configuration (Gmail SMTP or Resend API)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="noreply@thaisonfoods.vn"
SMTP_PASS="your_gmail_app_password"
EMAIL_FROM="Thái Sơn Foods <noreply@thaisonfoods.vn>"
# RESEND_API_KEY=""

# 7. Google Maps Platform (Places Autocomplete & Geocoding API)
# Lấy từ Google Cloud Console (APIs & Services > Credentials > Create API Key):
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# 8. Lưu trữ ảnh/video admin tải lên (bắt buộc khi chạy trên Vercel)
# Vercel → Storage → Create → Blob, rồi Connect vào dự án; token được tự thêm vào biến môi trường
BLOB_READ_WRITE_TOKEN=""
# Máy chủ riêng (không dùng Blob): thư mục lưu ảnh/video admin tải lên. Đặt NGOÀI thư mục build để không mất khi
# build lại / deploy, và đưa vào lịch backup. Bỏ trống = public/uploads (máy phát triển). URL ảnh vẫn là /uploads/...
UPLOAD_DIR=

# 9. Công tắc go-live
# Ẩn khối "Bản mẫu" với khách (chỉ đặt true để demo nội bộ)
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false
# Chức năng chưa chốt — mặc định TẮT (xem docs/golive/BAT-LAI-CHUC-NANG.md)
NEXT_PUBLIC_ENABLE_PARTNER_PROGRAM=false   # CTV/Đại lý/Payouts
# Đăng nhập Google/Facebook: BẬT mặc định; từng nút chỉ hiện khi có khóa (mục 5). Đặt false để tắt hẳn
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=true

# 10. Tồn kho lấy từ Google Sheet (tab INPUT DATA, quyền chỉ xem - web không ghi vào sheet)
# Mặc định NHẬP TAY ('manual'): admin cập nhật số lượng trên web. Đặt sheet để đọc tồn từ Google Sheet
INVENTORY_SOURCE=manual
# ID file Google Sheet (đã chia sẻ "Bất kỳ ai có đường liên kết đều xem được") và tên tab nguồn
INVENTORY_SHEET_ID="1jZx1hFqgCcSKBAZ5XEUcaZxh0mdVyxDg1yLvPCIWAb0"
INVENTORY_SHEET_TAB="INPUT DATA"
# (tùy chọn) Link CSV tự chọn, ví dụ link "Xuất bản lên web" của tab; ưu tiên hơn ID + tab
# INVENTORY_SHEET_CSV_URL=""
# Chu kỳ tự đọc lại sheet khi có người xem tồn kho (5-120 phút, mặc định 15)
INVENTORY_SHEET_REFRESH_MINUTES=15

# 7. Báo đơn mới về Zalo (Zalo Bot - bot.zaloplatforms.com). Để trống = tắt.
#    Lấy chat_id: nhắn cho bot rồi chạy node scripts/zalo-get-chat-ids.mjs
ZALO_BOT_TOKEN=
ZALO_ORDER_CHAT_IDS=

# 8. Báo đơn mới qua Telegram (@thaisonfoods_order_bot). Để trống = tắt.
#    Lấy chat_id: người nhận /start bot rồi mở https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_IDS=

# 13. Hạn lưu giữ nhật ký (số ngày, tối thiểu 7). Mỗi đêm cron /api/cron/cleanup-reservations xuất nhật ký quá hạn
# ra file .jsonl.gz rồi mới xoá khỏi DB. Có BLOB_READ_WRITE_TOKEN thì file lưu trên Vercel Blob (private, thư mục log-archive/);
# không có thì lưu vào LOG_ARCHIVE_DIR (bỏ trống = backups/log-archive trong thư mục app).
LOG_RETENTION_SHEET_SYNC_DAYS=90
LOG_RETENTION_INVENTORY_DAYS=730
LOG_RETENTION_AUTH_DAYS=180
LOG_RETENTION_AUDIT_DAYS=730
LOG_ARCHIVE_DIR=

# 10. Gợi ý địa chỉ / bản đồ (xem docs/DIA-CHI-NHA-CUNG-CAP.md)
# Nhà cung cấp gợi ý: photon (mặc định) | google (cần GOOGLE_MAPS_API_KEY). goong / vietmap chưa tích hợp
GEO_PROVIDER=photon
# Máy chủ Photon tự host (vd. http://127.0.0.1:2322). Để trống = bản công cộng photon.komoot.io, CHỈ dùng khi phát triển
PHOTON_BASE_URL=
# Danh tính app khi gọi dịch vụ OSM công cộng (bắt buộc khi chạy thật): tên web, địa chỉ web, email liên hệ của shop
GEO_APP_NAME=ThaiSonFoods
GEO_SITE_URL=
GEO_CONTACT_EMAIL=
# Hạn chờ nhà cung cấp gợi ý (ms), mặc định 2000
GEO_TIMEOUT_MS=2000
# Production: lược đồ DB chỉ đổi qua migration; đặt 1 để tạm bật lại việc tự CREATE/ALTER lúc chạy (mặc định tắt khi NODE_ENV=production)
DB_SCHEMA_BOOTSTRAP=
# Ảnh vệ tinh Esri trên bản đồ ghim: chỉ đặt 1 khi đã mua giấy phép thương mại của Esri
NEXT_PUBLIC_MAP_SATELLITE=
