# ==============================================================================
# THÁI SƠN FOODS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO THIS FILE.
# ==============================================================================

# 1. PostgreSQL Database Configuration
DATABASE_URL="postgresql://username:password@127.0.0.1:5432/WebTSF_production?sslmode=disable"
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="your_database_password_here"
DB_NAME="WebTSF_production"
NEXT_PUBLIC_APP_URL="https://thaisonfoods.vn"

# 2. Authentication & JWT Security
# Generate high-entropy secret: openssl rand -base64 48
JWT_SECRET="replace_with_a_secure_random_jwt_secret_min_32_characters"
ADMIN_REGISTER_KEY="replace_with_secure_initial_admin_register_key"

# 3. Security & Feature Toggles
# MUST be false on production to prevent unauthorized account takeover bypass
ENABLE_MOCK_OAUTH=false

# 4. Automated Cronjob Authentication Key
# Generate high-entropy secret: openssl rand -hex 32
CRON_SECRET="replace_with_strong_random_cron_secret_min_32_characters"

# 5. Social OAuth 2.0 (Google & Facebook)
# Google Cloud Console (APIs & Services > Credentials):
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta for Developers (developers.facebook.com > App Dashboard):
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# 6. Email Service Configuration (Gmail SMTP or Resend API)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="noreply@thaisonfoods.vn"
SMTP_PASS="your_gmail_app_password"
EMAIL_FROM="Thái Sơn Foods <noreply@thaisonfoods.vn>"
# RESEND_API_KEY=""

# 7. Google Maps Platform (Places Autocomplete & Geocoding API)
# Lấy từ Google Cloud Console (APIs & Services > Credentials > Create API Key):
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# 8. Lưu trữ ảnh/video admin tải lên (bắt buộc khi chạy trên Vercel)
# Vercel → Storage → Create → Blob, rồi Connect vào dự án; token được tự thêm vào biến môi trường
BLOB_READ_WRITE_TOKEN=""

# 9. Công tắc go-live
# Ẩn khối "Bản mẫu" với khách (chỉ đặt true để demo nội bộ)
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false
# Chức năng chưa chốt — mặc định TẮT (xem docs/golive/BAT-LAI-CHUC-NANG.md)
NEXT_PUBLIC_ENABLE_PARTNER_PROGRAM=false   # CTV/Đại lý/Payouts
# Đăng nhập Google/Facebook: BẬT mặc định; từng nút chỉ hiện khi có khóa (mục 5). Đặt false để tắt hẳn
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=true

# 10. Tồn kho lấy từ Google Sheet (tab INPUT DATA, quyền chỉ xem - web không ghi vào sheet)
# Mặc định BẬT ('sheet'). Đặt manual để quay về admin nhập tay số lượng trên web
INVENTORY_SOURCE=sheet
# ID file Google Sheet (đã chia sẻ "Bất kỳ ai có đường liên kết đều xem được") và tên tab nguồn
INVENTORY_SHEET_ID="1jZx1hFqgCcSKBAZ5XEUcaZxh0mdVyxDg1yLvPCIWAb0"
INVENTORY_SHEET_TAB="INPUT DATA"
# (tùy chọn) Link CSV tự chọn, ví dụ link "Xuất bản lên web" của tab; ưu tiên hơn ID + tab
# INVENTORY_SHEET_CSV_URL=""
# Chu kỳ tự đọc lại sheet khi có người xem tồn kho (5-120 phút, mặc định 15)
INVENTORY_SHEET_REFRESH_MINUTES=15
